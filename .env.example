# Copy to .env (chmod 600) and fill in. Compose reads .env automatically.
#
# Only what the server needs before it can read its own settings lives here.
# Everything else (the players' address, how long games are kept, upload size,
# changing the host password) is under Settings in the app: open /host/settings.

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The host password a new server starts with. Players never need it.
# It is read once, when the server has no password yet; after that, change it in
# Settings. Left empty, the server starts open: anyone who can reach it can host,
# read every answer and set the password themselves.
BUZZOFF_ADMIN_PASSWORD=

# Port published on the Docker host.
BUZZOFF_PORT=3210

# Reverse proxies in front of the app: 0 if exposed directly, 1 behind Nginx Proxy Manager,
# 2 behind Cloudflare + Nginx Proxy Manager.
TRUST_PROXY=1

TZ=Europe/Malta
