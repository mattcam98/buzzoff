# Copy to .env (chmod 600) and fill in. Compose reads .env automatically.

# Database password. Use letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for hosting games and editing question packs. Players never need it.
# Without it, anyone who can reach the server can host and can read every answer.
BUZZOFF_ADMIN_PASSWORD=

# Port published on the Docker host.
BUZZOFF_PORT=3210

# Public address players use, e.g. https://buzz.example.com. Leave empty on a LAN
# and the lobby shows whatever address the TV screen was opened with.
PUBLIC_URL=

# Reverse proxies in front of the app: 0 if exposed directly, 1 behind Nginx Proxy Manager,
# 2 behind Cloudflare + Nginx Proxy Manager.
TRUST_PROXY=1

TZ=Europe/Malta
